# Firebase client config - browser-safe
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DRILL_ID=active-drill

# Firebase Admin SDK - server-only
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Current proof-of-concept compatibility - server-only
# Prefer the split Firebase Admin variables above for new Reunify code.
FIREBASE_SERVICE_ACCOUNT_JSON=

# OpenRouter - server-only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Reunify

# Demo auth / local development
ALLOW_DEMO_AUTH=true

# Parent-safe SMS notifications - server-only.
# Default is dry-run: messages are NOT sent unless SMS_NOTIFICATIONS_ENABLED=true
# AND all three Twilio variables below are set. Trial accounts can only SMS
# verified recipient numbers.
SMS_NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
